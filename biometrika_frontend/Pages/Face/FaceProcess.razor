@page "/face/process"
@inject NavigationManager Navigation

<PageTitle>Reconnaissance Faciale</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h2 class="fw-semibold mb-3">Reconnaissance Faciale</h2>
                        <p class="text-muted">Sélectionnez une opération à effectuer</p>
                    </div>

                    <div class="row g-4">
                        <!-- Enrollment Section -->
                        <div class="col-md-6">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body p-4 text-center">
                                    <div class="mb-4">
                                        <i class="bi bi-person-plus" style="font-size: 4rem; opacity: 0.6;"></i>
                                    </div>
                                    <h3 class="fw-semibold mb-3">Enregistrement Facial</h3>
                                    <p class="text-muted mb-4">Enregistrer un nouveau visage pour un utilisateur</p>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">ID Utilisateur</label>
                                        <input type="number" class="form-control" @bind="EnrollUserId" placeholder="Entrez l'ID utilisateur" min="1" />
                                    </div>
                                    
                                    <button type="button" class="btn btn-dark w-100" style="border-radius: 6px; padding: 12px;" @onclick="GoToEnroll" disabled="@(EnrollUserId <= 0)">
                                        <i class="bi bi-camera"></i> Enregistrer un visage
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Verification Section -->
                        <div class="col-md-6">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body p-4 text-center">
                                    <div class="mb-4">
                                        <i class="bi bi-person-check" style="font-size: 4rem; opacity: 0.6;"></i>
                                    </div>
                                    <h3 class="fw-semibold mb-3">Vérification Faciale</h3>
                                    <p class="text-muted mb-4">Vérifier l'identité d'un utilisateur par son visage</p>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">ID Utilisateur</label>
                                        <input type="number" class="form-control" @bind="VerifyUserId" placeholder="Entrez l'ID utilisateur" min="1" />
                                    </div>
                                    <button type="button" class="btn btn-dark w-100" style="border-radius: 6px; padding: 12px;" @onclick="GoToVerify" disabled="@(VerifyUserId <= 0)">
                                        <i class="bi bi-check-circle"></i> Vérifier un visage
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int EnrollUserId { get; set; }
    private int VerifyUserId { get; set; }

    private void GoToEnroll()
    {
        if (EnrollUserId > 0)
        {
            Navigation.NavigateTo($"/face/enroll/{EnrollUserId}");
        }
    }

    private void GoToVerify()
    {
        if (VerifyUserId > 0)
        {
            Navigation.NavigateTo($"/face/verify/{VerifyUserId}/");
        }
    }
}