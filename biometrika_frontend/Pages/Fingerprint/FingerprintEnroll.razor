@page "/fingerprint/enroll/{userId:int}"
@page "/fingerprint/enroll"
@using System.Text.Json
@implements IDisposable
@inject FingerprintApiService FingerprintService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Enregistrement d'Empreinte</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-semibold">Enregistrement d'empreinte</h2>
                        @if (UserId > 0)
                        {
                            <p class="text-muted">Utilisateur ID: @UserId</p>
                        }
                    </div>

                    @if (string.IsNullOrEmpty(SessionId) && !IsLoading)
                    {
                        <!-- Étape 1: Initialiser la session automatiquement -->
                        <div class="text-center py-5">
                            <div class="mb-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Chargement...</span>
                                </div>
                            </div>
                            <h4 class="fw-semibold mb-3">Initialisation de la session...</h4>
                            <p class="text-muted">Préparation de la capture mobile</p>
                        </div>
                    }
                    else if (SessionStatus == "waiting")
                    {
                        <!-- Étape 2: Afficher l'URL à ouvrir sur le téléphone -->
                        <div class="text-center py-4">
                            <div class="mb-3">
                                <i class="bi bi-phone" style="font-size: 3rem; color: #0d6efd;"></i>
                            </div>
                            <h4 class="fw-semibold mb-2">Ouvrez cette URL sur votre téléphone</h4>
                            <p class="text-muted mb-3">
                                Ouvrez le lien ci-dessous dans le navigateur de votre téléphone (connecté au même réseau WiFi)
                            </p>
                            
                            <div class="bg-light p-3 rounded mb-3" style="border: 2px dashed #0d6efd;">
                                <code id="mobileUrl" style="font-size: 1.1rem; word-break: break-all; color: #0d6efd;">@MobileUrl</code>
                            </div>
                            
                            <button type="button" @onclick="CopyUrlToClipboard" class="btn btn-outline-primary mb-3" style="border-radius: 6px;">
                                <i class="bi bi-clipboard"></i> Copier le lien
                            </button>

                            <div class="alert alert-info" style="border-radius: 8px;">
                                <i class="bi bi-info-circle"></i>
                                <strong>Instructions :</strong>
                                <ol class="text-start mt-2 mb-0">
                                    <li>Ouvrez ce lien sur votre téléphone</li>
                                    <li>Capturez l'empreinte avec la caméra arrière</li>
                                    <li>Cliquez sur "Envoyer"</li>
                                    <li>Le résultat apparaîtra automatiquement ici</li>
                                </ol>
                            </div>

                            <div class="mt-3">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">En attente...</span>
                                </div>
                                <p class="text-muted mt-2">En attente de la capture depuis le téléphone...</p>
                            </div>
                        </div>
                    }
                    else if (SessionStatus == "completed" && IsSuccess)
                    {
                        <!-- Étape 3: Succès -->
                        <div class="text-center py-4">
                            <div class="mb-3">
                                <i class="bi bi-check-circle" style="font-size: 4rem; color: #198754;"></i>
                            </div>
                            <h4 class="fw-semibold text-success mb-3">Empreinte enregistrée !</h4>
                            
                            <div class="bg-light p-4 rounded mb-3">
                                <p class="mb-1 text-muted">Template ID</p>
                                <h3 class="fw-bold mb-0">@LastTemplateId</h3>
                            </div>

                            @if (!string.IsNullOrEmpty(LastTemplate))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Template (base64)</label>
                                    <textarea class="form-control" rows="2" readonly style="border-radius: 6px; font-size: 0.8rem;">@LastTemplate</textarea>
                                </div>
                            }

                            <button type="button" @onclick="ResetSession" class="btn btn-outline-secondary mt-2" style="border-radius: 6px;">
                                <i class="bi bi-arrow-repeat"></i> Nouvel enregistrement
                            </button>
                        </div>
                    }
                    else if (SessionStatus == "error" || (SessionStatus == "completed" && !IsSuccess))
                    {
                        <!-- Erreur -->
                        <div class="text-center py-4">
                            <div class="mb-3">
                                <i class="bi bi-x-circle" style="font-size: 4rem; color: #dc3545;"></i>
                            </div>
                            <h4 class="fw-semibold text-danger mb-3">Erreur</h4>
                            <p class="text-muted mb-3">@StatusMessage</p>
                            <button type="button" @onclick="ResetSession" class="btn btn-outline-secondary" style="border-radius: 6px;">
                                <i class="bi bi-arrow-repeat"></i> Réessayer
                            </button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(StatusMessage) && SessionStatus != "completed")
                    {
                        <div class="alert mt-3 @(IsSuccess ? "alert-success" : "alert-danger")" style="border-radius: 6px;">
                            @StatusMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int UserId { get; set; }
    
    private string? SessionId { get; set; }
    private string? MobileUrl { get; set; }
    private string? SessionStatus { get; set; }
    private string? StatusMessage { get; set; }
    private bool IsSuccess { get; set; }
    private bool IsLoading { get; set; }
    private string? LastTemplate { get; set; }
    private int LastTemplateId { get; set; }
    private CancellationTokenSource? _pollingCts;
    private string? _baseUrl;

    protected override void OnInitialized()
    {
        // Construire l'URL de base du backend fingerprint (HTTPS)
        var baseUri = new Uri(Navigation.BaseUri);
        _baseUrl = $"https://{baseUri.Host}:7000";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(SessionId))
        {
            await StartMobileSessionAsync();
        }
    }

    private async Task StartMobileSessionAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            using var httpClient = new HttpClient();
            var initResponse = await httpClient.PostAsJsonAsync($"{_baseUrl}/api/mobile-session/init", new
            {
                mode = "enroll",
                userId = UserId > 0 ? UserId : 1,
                templateId = 0
            });

            if (initResponse.IsSuccessStatusCode)
            {
                var result = await initResponse.Content.ReadFromJsonAsync<JsonElement>();
                SessionId = result.GetProperty("sessionId").GetString();
                
                // URL simplifiée : le téléphone se redirigera automatiquement
                MobileUrl = $"{_baseUrl}/mobile/";
                SessionStatus = "waiting";
                
                // Démarrer le polling
                StartPolling();
            }
            else
            {
                StatusMessage = "Erreur lors de l'initialisation de la session";
                IsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Erreur: {ex.Message}";
            IsSuccess = false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void StartPolling()
    {
        _pollingCts?.Cancel();
        _pollingCts = new CancellationTokenSource();
        var token = _pollingCts.Token;

        Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(2000, token);
                    if (token.IsCancellationRequested) break;

                    using var httpClient = new HttpClient();
                    var response = await httpClient.GetAsync($"{_baseUrl}/api/mobile-session/{SessionId}/result", token);
                    
                    if (response.IsSuccessStatusCode)
                    {
                        var result = await response.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: token);
                        var status = result.GetProperty("status").GetString();

                        if (status != "waiting")
                        {
                            var success = result.GetProperty("success").GetBoolean();
                            
                            await InvokeAsync(() =>
                            {
                                SessionStatus = status;
                                IsSuccess = success;
                                StatusMessage = result.GetProperty("message").GetString();

                                if (success && result.TryGetProperty("templateId", out var templateIdProp))
                                {
                                    LastTemplateId = templateIdProp.GetInt32();
                                }
                                if (success && result.TryGetProperty("template", out var templateProp))
                                {
                                    LastTemplate = templateProp.GetString();
                                }

                                StateHasChanged();
                            });

                            break;
                        }
                    }
                }
                catch (TaskCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Polling error: {ex.Message}");
                }
            }
        }, token);
    }

    private async Task CopyUrlToClipboard()
    {
        if (!string.IsNullOrEmpty(MobileUrl))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", MobileUrl);
            StatusMessage = "Lien copié dans le presse-papiers !";
            IsSuccess = true;
            StateHasChanged();
        }
    }

    private void ResetSession()
    {
        _pollingCts?.Cancel();
        SessionId = null;
        MobileUrl = null;
        SessionStatus = null;
        StatusMessage = null;
        IsSuccess = false;
        LastTemplate = null;
        LastTemplateId = 0;
        StateHasChanged();
    }

    public void Dispose()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
    }
}